# =============================
# Local runtime data (sqlite, etc.)
# =============================
# Anchored to repo root — unanchored "data/" case-insensitively matched the
# SmartStudyPlanner/Data and SmartStudyPlanner.Tests/Data *source* folders on
# Windows (core.ignorecase=true), silently swallowing new files added there.
/data/

# =============================
# Archived design scratch (kept local, superseded by shipped UI)
# =============================
legacy/

# =============================
# Personal tooling — local to the owner, deliberately not shared
# =============================
# Session prompt drafts and one-off verification scripts. These are working
# material, not project artifacts: nothing in the build, the suite or CI reads
# them, and they were the last two entries making `git status` noisy after WP-6
# retired the root Assets/ folder. Owner decision, 2026-08-02.
/Prompt/
/tools/epic1_b2_verify.py

# =============================
# S0 encoder pilot — local model artifacts (AST-05)
# =============================
# The neural-encoder pilot downloads hundreds of MB of encoder + tokenizer
# artifacts. AST-05 forbids an encoder binary entering git at any commit of this
# initiative, so the artifacts live only here and only untracked. The CI step
# "Assert no model binary is tracked" is the guard that makes this checkable —
# this block is convenience, that step is the contract.
tools/ml-pilot/models/
*.onnx
*.onnx_data
*.safetensors
*.gguf
*.tflite
# SentencePiece vocabularies ship as `tokenizer.model`. Anchored to the pilot
# tree so a future `*.model` source file elsewhere is not silently swallowed.
tools/ml-pilot/**/*.model

# Python bytecode from the pilot harness scripts
__pycache__/
*.pyc

# =============================
# Claude Code per-machine settings
# =============================
# `settings.local.json` is Claude Code's per-machine file: it accumulates
# permission grants that include absolute paths to this machine (home dir,
# editor install, node binary). Tracking it conflicts on every other checkout
# and leaks local layout. `.claude/settings.json` — the shared config — stays
# tracked deliberately.
.claude/settings.local.json
