<Page x:Class="SmartStudyPlanner.QuanLyTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SmartStudyPlanner.Converters"
      Title="Quản Lý Bài Tập / Deadline"
      Background="{DynamicResource AppBackground}">

    <!--
      REDESIGN — Workspace deadline của một môn. Smart Add nâng lên HERO trên cùng.
      Giữ NGUYÊN binding & command của QuanLyTaskViewModel:
        QuayLaiCommand · TieuDe
        Smart Add : VanBanNhapNhanh · QuickInputHint · PhanTichNhapNhanhCommand
        Form      : TenTask · HanChot · LoaiTaskIndex · DoKho · TextNutThem · MauNutThem · ThemTaskCommand
        Bảng      : MonHocHienTai.DanhSachTask (TenTask/HanChot/LoaiTask/DoKho/TrangThai/DiemUuTien/MucDoCanhBao)
                    + HoanThanhTaskCommand · SuaTaskCommand · XoaTaskCommand
        HasData/EmptyStateMessage · Ghi chú (NoteContent/ClearNoteCommand)
        Liên kết  : NewLinkTitle/NewLinkUrl/AddLinkCommand/StudyLinks/OpenLinkCommand/CopyLinkCommand/RemoveLinkCommand
      x:Name="dgDanhSachTask" giữ nguyên cho code-behind (dgDanhSachTask.Items.Refresh).
    -->

    <Page.Resources>
        <conv:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <conv:ScoreToWidthConverter   x:Key="ScoreToWidth"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel Margin="24,22,24,30">

            <Button Content="← Quay lại Môn Học" Style="{StaticResource WsBackButton}"
                    Command="{Binding QuayLaiCommand}" Margin="0,0,0,14"/>

            <!-- eyebrow header -->
            <TextBlock Text="QUẢN LÝ DEADLINE" Style="{StaticResource WsEyebrow}"/>
            <TextBlock Text="{Binding TieuDe}" Style="{StaticResource WsPageTitle}" Margin="0,5,0,18"/>

            <!-- ─────────── SMART ADD HERO ─────────── -->
            <Border Style="{StaticResource WsSmartAddCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource WsTagPill}">
                        <TextBlock Text="NHẬP LIỆU SIÊU TỐC · AI" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"/>
                    </Border>
                    <TextBlock Text="Dán tin nhắn của lớp trưởng — hệ thống tự bóc tách thành deadline"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,11,0,0"/>
                    <TextBlock Text="Không cần điền tay. Dán nguyên văn thông báo, AI nhận diện tên bài, hạn chót, loại sự kiện và độ khó."
                               FontSize="12.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource WsInput}" Height="46" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding VanBanNhapNhanh, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Tự điền" Style="{StaticResource WsSolidButton}"
                                Padding="22,0" Command="{Binding PhanTichNhapNhanhCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding QuickInputHint}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ─────────── ADD / EDIT TASK FORM ─────────── -->
            <Border Style="{StaticResource WsPanel}" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource AccentColor}"/>
                        <TextBlock Text="THÊM / SỬA DEADLINE" Style="{StaticResource WsSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,11,0">
                            <TextBlock Text="Tên bài tập" Style="{StaticResource WsFieldLabel}"/>
                            <TextBox Style="{StaticResource WsInput}"
                                     Text="{Binding TenTask, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,11,0">
                            <TextBlock Text="Hạn chót" Style="{StaticResource WsFieldLabel}"/>
                            <DatePicker Height="34" VerticalContentAlignment="Center"
                                        SelectedDate="{Binding HanChot}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,11,0">
                            <TextBlock Text="Loại sự kiện" Style="{StaticResource WsFieldLabel}"/>
                            <ComboBox Height="34" VerticalContentAlignment="Center"
                                      SelectedIndex="{Binding LoaiTaskIndex}">
                                <ComboBoxItem Content="Bài Tập Về Nhà"/>
                                <ComboBoxItem Content="Kiểm Tra Thường Xuyên"/>
                                <ComboBoxItem Content="Thi Giữa Kỳ"/>
                                <ComboBoxItem Content="Đồ Án Cuối Kỳ"/>
                                <ComboBoxItem Content="Thi Cuối Kỳ"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,11,0">
                            <TextBlock Text="Độ khó 1–5" Style="{StaticResource WsFieldLabel}"/>
                            <TextBox Style="{StaticResource WsInput}" HorizontalContentAlignment="Center"
                                     Text="{Binding DoKho, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Height="34" MinWidth="150" FontWeight="Bold" Foreground="White" Cursor="Hand"
                                    Content="{Binding TextNutThem}" Background="{Binding MauNutThem}"
                                    Command="{Binding ThemTaskCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- empty state -->
            <Border Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppEmptyStateCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyStateMessage}" Foreground="{DynamicResource SecondaryText}"/>
            </Border>

            <!-- ─────────── TASK TABLE ─────────── -->
            <Border Style="{StaticResource WsCard}" Padding="0" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,15,16,4">
                        <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource WarningColor}"/>
                        <TextBlock Text="BÀI TẬP CỦA MÔN" Style="{StaticResource WsSectionTitle}"/>
                        <TextBlock Text="sắp theo Điểm ưu tiên" Style="{StaticResource WsSectionSub}"/>
                    </StackPanel>

                    <DataGrid x:Name="dgDanhSachTask" Style="{StaticResource WsDataGrid}"
                              ItemsSource="{Binding MonHocHienTai.DanhSachTask}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên bài tập" Binding="{Binding TenTask}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hạn chót" Binding="{Binding HanChot, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding LoaiTask}" Width="130"/>
                            <DataGridTextColumn Header="Độ khó" Binding="{Binding DoKho}" Width="70"/>

                            <!-- Điểm ưu tiên + meter -->
                            <DataGridTemplateColumn Header="Điểm ƯT" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiemUuTien}" FontWeight="Bold"
                                                       Foreground="{Binding DiemUuTien, Converter={StaticResource PriorityBrush}}"
                                                       Width="32"/>
                                            <Border Width="40" Height="4" CornerRadius="2"
                                                    Background="{DynamicResource BorderColor}" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="2"
                                                        Background="{Binding DiemUuTien, Converter={StaticResource PriorityBrush}}"
                                                        Width="{Binding DiemUuTien, Converter={StaticResource ScoreToWidth}, ConverterParameter=40}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mức độ pill (task đã xong → nền xám SeverityDone) -->
                            <DataGridTemplateColumn Header="Mức độ" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource WsPill}">
                                                    <Setter Property="Background"
                                                            Value="{Binding DiemUuTien, Converter={StaticResource PriorityBrush}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MucDoCanhBao}" Value="Đã xong">
                                                            <Setter Property="Background" Value="{StaticResource SeverityDone}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MucDoCanhBao}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác -->
                            <DataGridTemplateColumn Header="Thao tác" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Xong" Style="{StaticResource WsSolidButton}" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.HoanThanhTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Sửa" Style="{StaticResource WsWarnButton}" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.SuaTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Xóa" Style="{StaticResource WsDangerButton}"
                                                    Command="{Binding DataContext.XoaTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ─────────── NOTES + LINKS ─────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Notes -->
                <Border Grid.Column="0" Style="{StaticResource WsPanel}" Margin="0,0,9,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource AccentColor}"/>
                            <TextBlock Text="GHI CHÚ" Style="{StaticResource WsSectionTitle}"/>
                        </StackPanel>
                        <TextBox Text="{Binding NoteContent, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" Padding="11,9"
                                 Background="{DynamicResource ChartBackground}" Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                        <Button Content="Xóa ghi chú" Style="{StaticResource WsGhostButton}"
                                HorizontalAlignment="Left" Margin="0,9,0,0"
                                Command="{Binding ClearNoteCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Grid.Column="1" Style="{StaticResource WsPanel}" Margin="9,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="LIÊN KẾT HỌC TẬP" Style="{StaticResource WsSectionTitle}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource WsInput}" Margin="0,0,6,0"
                                     Text="{Binding NewLinkTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource WsInput}" Margin="0,0,6,0"
                                     Text="{Binding NewLinkUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="+ Thêm" Style="{StaticResource WsSolidButton}"
                                    Command="{Binding AddLinkCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StudyLinks}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource PrimaryText}"/>
                                                <TextBlock Text="{Binding Url}" Foreground="{DynamicResource AccentColor}"
                                                           TextTrimming="CharacterEllipsis" FontSize="11"/>
                                                <TextBlock Text="{Binding DomainHost}" Foreground="{DynamicResource SecondaryText}" FontSize="10.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Mở" Style="{StaticResource WsSolidButton}" Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Sao chép" Style="{StaticResource WsGhostButton}" Margin="0,0,5,0"
                                                        Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Xóa" Style="{StaticResource WsDangerButton}"
                                                        Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
