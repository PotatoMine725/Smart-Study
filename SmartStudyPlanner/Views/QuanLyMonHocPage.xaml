<Page x:Class="SmartStudyPlanner.QuanLyMonHocPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SmartStudyPlanner.Converters"
      Title="Quản Lý Môn Học"
      Background="{DynamicResource AppBackground}">

    <!--
      REDESIGN — Danh sách môn học dạng "thẻ môn" (subject cards).
      Giữ NGUYÊN binding & command của QuanLyMonHocViewModel:
        TieuDe · QuayLaiCommand · TenMon · SoTinChi · TextNutThem · MauNutThem
        · ThemMonCommand · HocKyHienTai.DanhSachMonHoc (TenMonHoc/SoTinChi/DanhSachTask)
        · XemTaskCommand · SuaMonCommand · XoaMonCommand
      ItemsControl thay DataGrid nhưng dùng đúng collection cũ → 0 thay đổi VM.
      x:Name="dgDanhSachMon" giữ nguyên để code-behind (dgDanhSachMon.Items.Refresh) build OK.
    -->

    <Page.Resources>
        <conv:SubjectToBrushConverter x:Key="SubjectBrush"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel Margin="24,22,24,30">

            <Button Content="← Quay lại Dashboard" Style="{StaticResource WsBackButton}"
                    Command="{Binding QuayLaiCommand}" Margin="0,0,0,14"/>

            <!-- eyebrow header -->
            <TextBlock Text="MÔN HỌC" Style="{StaticResource WsEyebrow}"/>
            <TextBlock Text="{Binding TieuDe}" Style="{StaticResource WsPageTitle}"/>
            <TextBlock Text="Mỗi môn một màu nhận diện cố định. Bấm Tasks để mở workspace deadline của môn."
                       Style="{StaticResource WsSubText}" Margin="0,5,0,20"/>

            <!-- add subject -->
            <Border Style="{StaticResource WsPanel}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource SuccessColor}"/>
                        <TextBlock Text="THÊM MÔN HỌC MỚI" Style="{StaticResource WsSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tên môn học" Style="{StaticResource WsFieldLabel}"/>
                            <TextBox Style="{StaticResource WsInput}"
                                     Text="{Binding TenMon, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Tín chỉ" Style="{StaticResource WsFieldLabel}"/>
                            <TextBox Style="{StaticResource WsInput}" HorizontalContentAlignment="Center"
                                     Text="{Binding SoTinChi, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Width="150" Height="34" FontWeight="Bold" Foreground="White" Cursor="Hand"
                                    Content="{Binding TextNutThem}" Background="{Binding MauNutThem}"
                                    Command="{Binding ThemMonCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- section head -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource WsSectionTick}" Background="{DynamicResource AccentColor}"/>
                <TextBlock Text="DANH SÁCH MÔN HỌC" Style="{StaticResource WsSectionTitle}"/>
            </StackPanel>

            <!-- subject cards -->
            <ItemsControl x:Name="dgDanhSachMon" ItemsSource="{Binding HocKyHienTai.DanhSachMonHoc}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WsCard}" Margin="0,0,0,10" Padding="0"
                                BorderThickness="3,1,1,1"
                                BorderBrush="{Binding TenMonHoc, Converter={StaticResource SubjectBrush}}">
                            <Grid Margin="15,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- swatch -->
                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                        Margin="0,0,11,0"
                                        Background="{Binding TenMonHoc, Converter={StaticResource SubjectBrush}}"/>

                                <!-- name + credits -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TenMonHoc}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding SoTinChi, StringFormat={}{0} tín chỉ}"
                                                   FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Text="  ·  " FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Text="{Binding DanhSachTask.Count, StringFormat={}{0} task}"
                                                   FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Tasks" Style="{StaticResource WsSolidButton}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.XemTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Sửa" Style="{StaticResource WsWarnButton}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SuaMonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Xóa" Style="{StaticResource WsDangerButton}"
                                            Command="{Binding DataContext.XoaMonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
