<Page x:Class="SmartStudyPlanner.Views.WorkloadBalancerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SmartStudyPlanner.Converters"
      Background="{DynamicResource AppBackground}">

    <!--
      REDESIGN — Cân Bằng Tải (Workload Balancer) — điều hướng trong MainFrame.
      Binding của WorkloadBalancerViewModel + ScheduleModels:
        CapacityHours (mức slider đang trỏ tới — CHỈ slider và số 38pt ở khối SỨC HỌC dùng)
        RenderedCapacityHours (mức lịch hiện tại thực sự được dựng bằng — MỌI converter dùng)
        IsScheduleStale · GenerateScheduleCommand
        Schedule (ScheduleDay: DisplayName / TotalMinutes / HeaderText / Tasks)
        Tasks (ScheduledTask: TenTask / TenMon / SoPhut / ThoiGianHienThi)
      Thanh tải tương đối so với sức học được tính bằng converter
      [TotalMinutes, RenderedCapacityHours] (Converters/WorkloadConverters.cs). Đo theo
      CapacityHours là lỗi gốc: kéo slider chỉ chạy lại converter chứ không dựng lại lịch,
      nên màn hình vẽ phân bổ CŨ đo bằng mức trần MỚI.
      Màu chip theo môn dùng SubjectToBrushConverter có sẵn trong app.
      AncestorType=Page (không phải Window) vì page host trong Frame — ancestor Window
      lúc này là MainWindow (DataContext null) nên phải chỉ rõ Page.
    -->

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/WorkloadStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:SubjectToBrushConverter x:Key="SubjBrush"/>
            <conv:LoadToLengthConverter x:Key="LoadLen"/>
            <conv:LoadToBrushConverter x:Key="LoadBrush"/>
            <conv:FullDayToVisibilityConverter x:Key="FullVis"/>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="24,22,24,26">

            <!-- ─────────── HEADER ─────────── -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="CÂN BẰNG TẢI" Style="{StaticResource WbEyebrow}"/>
                <TextBlock Text="Trợ lý xếp lịch tự động" Style="{StaticResource WbPageTitle}"/>
                <TextBlock Text="Tự động xếp các bài tập chưa hoàn thành vào những ngày tới — theo điểm ưu tiên và sức học mỗi ngày của bạn."
                           Style="{StaticResource WbSubText}" MaxWidth="560" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- ─────────── CAPACITY CONTROL ─────────── -->
            <Border Style="{StaticResource WbCard}" Padding="22,20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- meta -->
                    <StackPanel Grid.Column="0" Width="218" VerticalAlignment="Center">
                        <TextBlock Text="SỨC HỌC MỖI NGÀY" Style="{StaticResource WbFieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CapacityHours, StringFormat={}{0:0.0}}"
                                       FontSize="38" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="giờ / ngày" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="7,0,0,8"/>
                        </StackPanel>
                        <TextBlock Text="Mức trần thời lượng học mỗi ngày. Thuật toán không xếp vượt quá ngưỡng này."
                                   FontSize="11.5" Foreground="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- slider -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0">
                        <Slider Minimum="1" Maximum="8" Value="{Binding CapacityHours}"
                                TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="1 giờ" FontSize="10.5" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="8 giờ" FontSize="10.5" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- action -->
                    <StackPanel Grid.Column="2" Width="172" VerticalAlignment="Center">
                        <Button Content="XẾP LỊCH LẠI" Style="{StaticResource WbSolidButton}"
                                Command="{Binding GenerateScheduleCommand}"/>
                        <TextBlock Text="Sắp xếp lại toàn bộ lịch học" Style="{StaticResource WbFieldLabel}"
                                   TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─────────── BALANCE CHART ─────────── -->
            <Border Style="{StaticResource WbPanel}" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource WbSectionTick}" Background="{StaticResource PlanAccent}"/>
                        <TextBlock Text="PHÂN BỔ TẢI THEO NGÀY" Style="{StaticResource WbSectionTitle}"/>
                        <TextBlock Text="phút / ngày · so với mức sức học" Style="{StaticResource WbSectionSub}"/>
                    </StackPanel>

                    <!-- Biểu đồ đang đo theo RenderedCapacityHours, slider đã trỏ sang mức khác.
                         Đặt ngay trên biểu đồ vì nó cảnh báo đúng thứ nằm bên dưới. -->
                    <Border Background="#1AFB3B53" BorderBrush="{DynamicResource SeverityUrgent}"
                            BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,10,0,0"
                            Visibility="{Binding IsScheduleStale, Converter={StaticResource BoolVis}}">
                        <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryText}">
                            <TextBlock.Text>
                                <Binding Path="RenderedCapacityHours"
                                         StringFormat="⚠ Lịch đang theo mức {0:0.0} giờ/ngày — bấm XẾP LỊCH LẠI để áp dụng mức mới."/>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- bars + capacity line -->
                        <Grid Grid.Row="0">
                            <Rectangle Height="1.5" VerticalAlignment="Top" Stroke="{StaticResource PlanAccent}"
                                       StrokeThickness="1.5" StrokeDashArray="4 3"/>
                            <ItemsControl ItemsSource="{Binding Schedule}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,0">
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                    Width="34" CornerRadius="3,3,2,2" ToolTip="{Binding HeaderText}">
                                                <Border.Height>
                                                    <MultiBinding Converter="{StaticResource LoadLen}" ConverterParameter="150">
                                                        <Binding Path="TotalMinutes"/>
                                                        <Binding Path="DataContext.RenderedCapacityHours" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                    </MultiBinding>
                                                </Border.Height>
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource LoadBrush}">
                                                        <Binding Path="TotalMinutes"/>
                                                        <Binding Path="DataContext.RenderedCapacityHours" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- day labels -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Schedule}" Margin="0,9,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="2,0"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock FontSize="10.5" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0">
                        <TextBlock.Text>
                            <Binding Path="RenderedCapacityHours" StringFormat="Đường nét đứt = mức sức học {0:0.0} giờ/ngày · cột chạm vạch là ngày đã đầy"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ─────────── DAY SCHEDULE ─────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                <Border Style="{StaticResource WbSectionTick}" Background="{DynamicResource SuccessColor}"/>
                <TextBlock Text="LỊCH HỌC CHI TIẾT" Style="{StaticResource WbSectionTitle}"/>
                <TextBlock Text="sắp theo Điểm ưu tiên" Style="{StaticResource WbSectionSub}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WbCard}" Padding="16,14" Margin="0,0,0,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="186"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- meta -->
                                <StackPanel Grid.Column="0" Margin="2,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="13.5"
                                               Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                                    <Border Style="{StaticResource WbMeterTrack}" Width="150" Margin="0,9,0,0">
                                        <Border HorizontalAlignment="Left" Height="6" CornerRadius="3">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource LoadLen}" ConverterParameter="150">
                                                    <Binding Path="TotalMinutes"/>
                                                    <Binding Path="DataContext.RenderedCapacityHours" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource LoadBrush}">
                                                    <Binding Path="TotalMinutes"/>
                                                    <Binding Path="DataContext.RenderedCapacityHours" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="ĐÃ ĐẠT MỨC TỐI ĐA" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource SeverityUrgent}" Margin="0,6,0,0">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource FullVis}">
                                                <Binding Path="TotalMinutes"/>
                                                <Binding Path="DataContext.RenderedCapacityHours" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </StackPanel>

                                <!-- tasks -->
                                <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource WbTaskChip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="9,0,0,9"
                                                            Background="{Binding TenMon, Converter={StaticResource SubjBrush}}"/>
                                                    <Grid Grid.Column="1" Margin="13,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" MaxWidth="260">
                                                            <TextBlock Text="{Binding TenTask}" FontWeight="SemiBold" FontSize="12.5"
                                                                       Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TenMon}" FontSize="11"
                                                                       Foreground="{DynamicResource SecondaryText}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ThoiGianHienThi}" FontWeight="Bold"
                                                                   FontSize="12.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource PrimaryText}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ─────────── ALGORITHM NOTES ─────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,11">
                <Border Style="{StaticResource WbSectionTick}" Background="#8B5CF6"/>
                <TextBlock Text="CÁCH THUẬT TOÁN XẾP LỊCH" Style="{StaticResource WbSectionTitle}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource WbCard}" BorderThickness="1" Padding="16,14" Margin="0,0,7,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="01" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource PlanAccent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Bài tập vượt sức học một ngày sẽ tự động được chia thành nhiều phần (Phần 1, Phần 2…)."
                                   FontSize="12.5" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource WbCard}" BorderThickness="1" Padding="16,14" Margin="7,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="02" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource PlanAccent}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="Mỗi bài được xếp vào ngày sớm nhất còn chỗ trống — học xong sớm, không để dồn về sát hạn."
                                   FontSize="12.5" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
