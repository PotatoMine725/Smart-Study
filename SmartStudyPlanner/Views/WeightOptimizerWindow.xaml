<Window x:Class="SmartStudyPlanner.Views.WeightOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trọng Số Ưu Tiên — AI Optimizer" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="⚖ Tối Ưu Trọng Số Ưu Tiên"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="Gợi ý từ AI dựa trên lịch sử học của bạn"
                           FontSize="12" Foreground="{DynamicResource SecondaryText}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Làm mới"
                    Command="{Binding LoadSuggestionCommand}"
                    Height="30" Padding="12,0"
                    Background="{DynamicResource CardBackground}"
                    Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource SidebarBorder}"
                    Cursor="Hand" VerticalAlignment="Top"/>
        </Grid>

        <!-- ── Main content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Loading indicator -->
                <TextBlock Text="Đang phân tích..." FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center" Margin="0,40,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- No suggestion / reject panel -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="8"
                        Padding="20" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        <Condition Binding="{Binding HasSuggestion}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Suggestion panel (HasSuggestion = True) -->
                <StackPanel Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">

                    <!-- Confidence card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Độ tin cậy" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- "AI khuyên dùng" badge — visible only for AutoApply -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Background="#2E86C1"
                                            Visibility="{Binding IsHighConfidence, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="AI khuyên dùng" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource AccentColor}">
                                        <TextBlock.Text>
                                            <Binding Path="Suggestion.Confidence" StringFormat="{}{0:P0}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding Suggestion.Confidence}" Minimum="0" Maximum="1"
                                         Height="8" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Suggestion.Rationale}"
                                       FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight comparison card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="So sánh trọng số" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

                            <!-- Header row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thành phần" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Grid.Column="1" Text="Hiện tại" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Đề xuất" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2E86C1" HorizontalAlignment="Center"/>
                            </Grid>
                            <Separator Background="{DynamicResource SidebarBorder}" Margin="0,0,0,8"/>

                            <!-- TimeWeight row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thời hạn" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="CurrentConfig.TimeWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                                           Foreground="#2E86C1" FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="Suggestion.Suggested.TimeWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!-- TaskTypeWeight row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Loại bài tập" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="CurrentConfig.TaskTypeWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                                           Foreground="#2E86C1" FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="Suggestion.Suggested.TaskTypeWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!-- CreditWeight row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số tín chỉ" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="CurrentConfig.CreditWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                                           Foreground="#2E86C1" FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="Suggestion.Suggested.CreditWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!-- DifficultyWeight row -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Độ khó" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="CurrentConfig.DifficultyWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                                           Foreground="#2E86C1" FontWeight="SemiBold" FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="Suggestion.Suggested.DifficultyWeight" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer: Apply button + status ── -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ApplyStatus}"
                       Foreground="#27AE60" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplyStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Command="{Binding ApplySuggestionCommand}"
                    Height="38" FontSize="14" FontWeight="SemiBold"
                    Foreground="White" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Áp dụng gợi ý"/>
                        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighConfidence}" Value="True">
                                <Setter Property="Background" Value="#2E86C1"/>
                                <Setter Property="Content" Value="⭐ Áp dụng gợi ý (AI khuyên dùng)"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

    </Grid>
</Window>
