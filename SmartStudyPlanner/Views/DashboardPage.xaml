<Page x:Class="SmartStudyPlanner.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SmartStudyPlanner.Converters"
      xmlns:ctl="clr-namespace:SmartStudyPlanner.Controls"
      Title="Dashboard" Loaded="Page_Loaded"
      Background="{DynamicResource AppBackground}">

    <!--
      DASHBOARD — REDESIGN  (native XAML charts)
      ========================================================================
      • Same DataContext (DashboardViewModel) and exact same commands.
      • Band A left: DonutChart (stroked-arc) + legend for TrangThaiSegments.
      • Band A right: grouped vertical bars for TienDoThoiGian via RatioLen.
      • Band B left: horizontal bars for KhoiLuongMonHoc via RatioLen.
      • All chart colours → DynamicResource / SubjectPalette (theme-reactive).
    -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:SubjectToBrushConverter          x:Key="SubjectBrush"/>
        <conv:ScoreToWidthConverter            x:Key="ScoreWidth"/>
        <conv:PriorityToBrushConverter         x:Key="PriorityBrush"/>
        <conv:RiskScoreToBrushConverter        x:Key="RiskBrush"/>
        <conv:StripLeadingGlyphConverter       x:Key="StripGlyph"/>
        <conv:RatioToLengthConverter           x:Key="RatioLen"/>
        <conv:StatusKeyToSeverityBrushConverter x:Key="StatusKeyBrush"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="26,24,26,30">

            <!-- ════════════════ HEADER BAND ════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="BẢNG ĐIỀU KHIỂN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentText}"/>
                    <TextBlock Text="{Binding TieuDe}" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- KPI strip -->
                <Border Grid.Column="1" Style="{StaticResource DashCard}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="22,13" MinWidth="116">
                            <TextBlock Text="TASK HÔM NAY" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding SoTaskHomNay}" Style="{StaticResource DashKpiValue}"/>
                        </StackPanel>
                        <Border Width="1" Background="{DynamicResource BorderColor}" Margin="0,12"/>
                        <StackPanel Margin="22,13" MinWidth="116">
                            <TextBlock Text="HOÀN THÀNH · TOP 5" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding TyLeHoanThanhText}" Style="{StaticResource DashKpiValue}"/>
                        </StackPanel>
                        <Border Width="1" Background="{DynamicResource BorderColor}" Margin="0,12"/>
                        <StackPanel Margin="22,13" MinWidth="116">
                            <TextBlock Text="STREAK DUY TRÌ" Style="{StaticResource DashKpiLabel}"/>
                            <TextBlock Text="{Binding ChuoiStreak, Converter={StaticResource StripGlyph}}"
                                       Style="{StaticResource DashKpiValue}" FontSize="22"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- loading state -->
            <Border Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppEmptyStateCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Đang tải dữ liệu dashboard..." Foreground="{DynamicResource SecondaryText}"/>
            </Border>

            <!-- empty state -->
            <Border Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppEmptyStateCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyStateMessage}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
            </Border>

            <!-- ════════════════ HERO — TOP 5 DEADLINES ════════════════ -->
            <Border Style="{StaticResource DashCard}" Margin="0,0,0,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,16,18,12">
                        <Border Style="{StaticResource DashSectionTick}" Background="{DynamicResource DangerColor}"/>
                        <TextBlock Text="TOP 5 DEADLINE KHẨN CẤP NHẤT" Style="{StaticResource DashSectionTitle}"/>
                        <TextBlock Text="sắp theo mức khẩn cấp" Style="{StaticResource DashSectionSub}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Top5Task}" Style="{StaticResource DashDataGrid}">
                        <DataGrid.Columns>

                            <!-- Môn Học: colour swatch + name -->
                            <DataGridTemplateColumn Header="MÔN HỌC" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,8,0"
                                                    Background="{Binding TenMonHoc, Converter={StaticResource SubjectBrush}}"/>
                                            <TextBlock Text="{Binding TenMonHoc}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tên Bài Tập (defect fixed: ElementStyle removed) -->
                            <DataGridTextColumn Header="TÊN BÀI TẬP" Binding="{Binding TenTask}" Width="*"/>

                            <!-- Hạn Chót -->
                            <DataGridTextColumn Header="HẠN CHÓT" Width="98"
                                                Binding="{Binding HanChot, StringFormat=dd/MM/yyyy}"/>

                            <!-- Đã học -->
                            <DataGridTextColumn Header="ĐÃ HỌC" Width="86"
                                                Binding="{Binding TaskGoc.ThoiGianDaHoc, StringFormat={}{0} phút}"/>

                            <!-- Độ Khẩn: number + mini urgency meter -->
                            <DataGridTemplateColumn Header="ĐỘ KHẨN" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiemUuTien, StringFormat={}{0:F0}}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryText}" Width="42"
                                                       ToolTip="{Binding DiemUuTien, StringFormat=Điểm khẩn cấp: {0:F1}/100}"/>
                                            <Border Width="40" Height="5" CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource BorderColor}">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{Binding DiemUuTien, Converter={StaticResource PriorityBrush}}"
                                                        Width="{Binding DiemUuTien, Converter={StaticResource ScoreWidth}, ConverterParameter=40}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mức Độ: pill -->
                            <DataGridTemplateColumn Header="MỨC ĐỘ" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DashPill}">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MucDoCanhBao}" Value="Khẩn cấp">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MucDoCanhBao}" Value="Chú ý">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MucDoCanhBao}" Value="An toàn">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MucDoCanhBao}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MucDoCanhBao}" Value="Khẩn cấp">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MucDoCanhBao}" Value="Chú ý">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MucDoCanhBao}" Value="An toàn">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding RiskScore, StringFormat=Điểm rủi ro: {0:P0}}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rủi Ro -->
                            <DataGridTemplateColumn Header="RỦI RO" Width="132">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MucDoRuiRo}" FontWeight="Bold" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding RiskScore, Converter={StaticResource RiskBrush}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cần học thêm -->
                            <DataGridTemplateColumn Header="CẦN HỌC THÊM" Width="124">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ThoiGianGoiY}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessColor}"/>
                                            <TextBlock Text=" *" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       Visibility="{Binding IsMLPrediction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="Dự đoán bằng AI — dựa trên lịch sử học của bạn"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="HỌC NGAY"
                                                    Command="{Binding DataContext.MoFocusModeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DashSolidButton}" Margin="0,0,6,0"/>
                                            <Button Content="Đi tới"
                                                    Command="{Binding DataContext.DiToiTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DashGhostButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="18,10,18,16" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               Text="*  Dự đoán bằng AI — dựa trên lịch sử học của bạn."/>
                </StackPanel>
            </Border>

            <!-- ════════════════ BAND A — status donut + time progress ════════════════ -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Band A left: status donut ── -->
                <Border Grid.Column="0" Style="{StaticResource DashPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource DashSectionTick}" Background="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="PHÂN BỐ TRẠNG THÁI" Style="{StaticResource DashSectionTitle}"/>
                        </StackPanel>

                        <!-- DonutChart + legend side by side -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctl:DonutChart Segments="{Binding TrangThaiSegments}" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding TrangThaiSegments}" Margin="18,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,7,0"
                                                    Background="{Binding Key, Converter={StaticResource StatusKeyBrush}}"/>
                                            <TextBlock FontSize="11.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryText}">
                                                <Run Text="{Binding Label}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Count}" FontWeight="Bold"
                                                     Foreground="{DynamicResource PrimaryText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Band A right: grouped bars — time progress ── -->
                <Border Grid.Column="2" Style="{StaticResource DashPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource DashSectionTick}" Background="{DynamicResource AccentColor}"/>
                            <TextBlock Text="TIẾN ĐỘ THỜI GIAN HỌC" Style="{StaticResource DashSectionTitle}"/>
                            <TextBlock Text="phút · Kỳ vọng vs Thực tế" Style="{StaticResource DashSectionSub}"/>
                        </StackPanel>

                        <!-- Series legend -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{DynamicResource AccentColor}"/>
                            <TextBlock Text="Kỳ vọng" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0"
                                    Background="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="Thực tế" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Grouped bar chart -->
                        <ItemsControl ItemsSource="{Binding TienDoThoiGian}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" ToolTip="{Binding Subject}">
                                        <!-- Fixed-height cell: StackPanel is bottom-aligned inside Grid -->
                                        <Grid Width="30" Height="150">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Border Width="11" Margin="1,0" CornerRadius="2,2,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource AccentColor}">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource RatioLen}" ConverterParameter="148">
                                                            <Binding Path="Expected"/>
                                                            <Binding Path="DataContext.MaxThoiGian"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                                <Border Width="11" Margin="1,0" CornerRadius="2,2,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SuccessColor}">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource RatioLen}" ConverterParameter="148">
                                                            <Binding Path="Actual"/>
                                                            <Binding Path="DataContext.MaxThoiGian"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <!-- X-axis label — same width as chart cell -->
                                        <TextBlock Text="{Binding Subject}" Width="30" FontSize="9"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Subject}"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════ BAND B — workload + today's schedule ════════════════ -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Band B left: horizontal bars — workload per subject ── -->
                <Border Grid.Column="0" Style="{StaticResource DashPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource DashSectionTick}" Background="{StaticResource SubjectColor3}"/>
                            <TextBlock Text="KHỐI LƯỢNG BÀI TẬP" Style="{StaticResource DashSectionTitle}"/>
                            <TextBlock Text="số bài / môn" Style="{StaticResource DashSectionSub}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding KhoiLuongMonHoc}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Subject}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Subject}" Margin="0,0,10,0"/>
                                        <!-- Track + fill bar -->
                                        <Border Grid.Column="1" Height="10" CornerRadius="3"
                                                VerticalAlignment="Center" ClipToBounds="True"
                                                Background="{DynamicResource BorderColor}">
                                            <Border HorizontalAlignment="Left" Height="10" CornerRadius="3"
                                                    Background="{Binding Subject, Converter={StaticResource SubjectBrush}}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource RatioLen}" ConverterParameter="200">
                                                        <Binding Path="Count"/>
                                                        <Binding Path="DataContext.MaxKhoiLuong"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
                                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Band B right: today's schedule ── -->
                <Border Grid.Column="2" Style="{StaticResource DashPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource DashSectionTick}" Background="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="{Binding TieuDeLichHomNay, Converter={StaticResource StripGlyph}}"
                                       Style="{StaticResource DashSectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding LichHocHomNay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashScheduleRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0"
                                                    Background="{Binding TenMon, Converter={StaticResource SubjectBrush}}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenTask}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TenMon}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ThoiGianHienThi}" FontWeight="Bold"
                                                       FontSize="11.5" Foreground="{DynamicResource SecondaryText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════ ADAPTATION STRIP ════════════════ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAdaptations}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Style="{StaticResource DashSectionTick}" Background="{StaticResource SubjectColor5}"/>
                    <TextBlock Text="GỢI Ý THÍCH NGHI" Style="{StaticResource DashSectionTitle}"/>
                    <TextBlock Text="tự động điều chỉnh theo tiến độ" Style="{StaticResource DashSectionSub}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding AdaptationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashAdaptationRow}">
                                <TextBlock Text="{Binding Message}" FontSize="12.5"
                                           Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
